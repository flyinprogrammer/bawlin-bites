{
  "name": "bawlin-bites",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "lint": "eslint .",
    "check": "tsc -b && vite build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply bawlin-bites --local",
    "db:migrate:remote": "wrangler d1 migrations apply bawlin-bites --remote"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "hono": "^4.13.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "wrangler": "^4.142.0"
  },
  "engines": {
    "node": ">=24"
  }
}
